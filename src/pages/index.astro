---
import Base from '../layouts/Base.astro';
import Cabecera from '../componentes/sitio/Cabecera.astro';
import Portada from '../componentes/secciones/Portada.astro';
import Garantias from '../componentes/secciones/Garantias.astro';
import Soluciones from '../componentes/secciones/Soluciones.astro';
import Portafolio from '../componentes/secciones/Portafolio.astro';
import Proceso from '../componentes/secciones/Proceso.astro';
import Preguntas from '../componentes/secciones/Preguntas.astro';
import Pie from '../componentes/sitio/Pie.astro';
import DatosNegocio from '../componentes/sitio/DatosNegocio.astro';
import negocio from '../datos/negocio.json';
---

<Base titulo={`${negocio.marca} · Desarrollo web y comercio electrónico`} descripcion={negocio.descripcion}>
	<DatosNegocio slot="head" />
	<Cabecera />
	<main id="contenido">
		<Portada />
		<Soluciones />
		<Garantias />
		<Portafolio />
		<Proceso />
		<Preguntas />
	</main>
	<Pie />
</Base>
