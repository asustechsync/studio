---
// Página de una solución, en bloques: encabezado, ejemplos, planes, lo que ganas, pasos y preguntas.
// Los textos salen de src/datos/soluciones.ts; los planes, de src/content/paquetes/.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cabecera from '../../componentes/sitio/Cabecera.astro';
import Pie from '../../componentes/sitio/Pie.astro';
import HeroSolucion from '../../componentes/secciones/solucion/HeroSolucion.astro';
import PlanesSolucion from '../../componentes/secciones/solucion/PlanesSolucion.astro';
import TresBloques from '../../componentes/secciones/solucion/TresBloques.astro';
import Portafolio from '../../componentes/secciones/Portafolio.astro';
import Preguntas from '../../componentes/secciones/Preguntas.astro';
import { soluciones } from '../../datos/soluciones';
import negocio from '../../datos/negocio.json';

export function getStaticPaths() {
	return soluciones.map((solucion) => ({ params: { slug: solucion.slug }, props: { solucion } }));
}

const { solucion } = Astro.props;

const paquetes = (await getCollection('paquetes', ({ data }) => data.publicado))
	.filter(({ id }) => solucion.paquetes.includes(id))
	.sort((a, b) => a.data.orden - b.data.orden);
const desde = paquetes.length ? Math.min(...paquetes.map(({ data }) => data.precio)) : null;
const mensaje = `Hola, me interesa la solución ${solucion.nombre}`;
---

<Base titulo={`${solucion.nombre} · ${negocio.marca}`} descripcion={`${solucion.titular}. ${solucion.texto}`}>
	<Cabecera />
	<main class="pagina-solucion" id="contenido">
		<HeroSolucion solucion={solucion} desde={desde} mensaje={mensaje} />
		<Portafolio solucion={solucion.slug} limite={4} titulo="Proyectos *desarrollados*" texto="Sitios web construidos para distintos sectores, con diseño profesional y listos para tu marca." />
		<PlanesSolucion titulo={solucion.titular} paquetes={paquetes} mensaje={mensaje} />
		<TresBloques titulo="Lo que *ganas*" bloques={solucion.beneficios} />
		<TresBloques titulo="Tres pasos, *sin vueltas*" bloques={solucion.pasos} numerados />
		<Preguntas lista={solucion.preguntas} titulo="Lo que suelen *preguntar*" texto={`Dudas sobre ${solucion.nombre.toLowerCase()}.`} />
	</main>
	<Pie />
</Base>

<style>
	/* Títulos de las páginas de solución: misma fuente del sitio, más apretada,
	   con las palabras destacadas solo en color (sin cursiva) */
	.pagina-solucion :global(h1),
	.pagina-solucion :global(h2) {
		letter-spacing: -0.03em;
	}

	.pagina-solucion :global(h1 em),
	.pagina-solucion :global(h2 em) {
		font-family: inherit;
		font-style: normal;
		font-size: 1em;
		font-weight: inherit;
		letter-spacing: inherit;
		color: var(--color-marca);
	}
</style>
