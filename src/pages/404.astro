---
import Interna from '../layouts/Interna.astro';
import Icono from '../componentes/ui/Icono.astro';
---

<Interna titulo="Página no encontrada" descripcion="La página que buscas no existe o cambió de dirección." indexar={false}>
	<section class="seccion">
		<div class="contenedor no-encontrada">
			<p class="no-encontrada__codigo">404</p>
			<div class="encabezado-seccion">
				<h1>Esta página <em>no existe</em></h1>
				<p>Puede que el enlace esté mal escrito o que la página haya cambiado de dirección.</p>
			</div>
			<div class="no-encontrada__acciones">
				<a class="boton boton--marca" href="/">Ir al inicio <Icono nombre="flecha" tamano={16} /></a>
				<a class="boton boton--claro" href="/soluciones">Ver soluciones</a>
			</div>
		</div>
	</section>
</Interna>

<style>
	.no-encontrada {
		text-align: center;
	}

	.no-encontrada__codigo {
		margin: 0 0 var(--espacio-3);
		font-family: var(--tipo-titulos);
		font-weight: 600;
		font-size: var(--titulo-sm);
		color: var(--color-marca-texto);
	}

	.no-encontrada h1 {
		font-size: var(--titulo-pagina);
	}

	.no-encontrada__acciones {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--espacio-3);
	}
</style>
