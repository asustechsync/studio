---
import '../estilos/global.css';
import sitio from '../datos/sitio.json';

interface Props {
	titulo: string;
	descripcion: string;
	/** Ruta de una imagen en public/ para la vista al compartir, por ejemplo "/compartir.jpg". */
	imagen?: string;
}

const { titulo, descripcion, imagen = sitio.imagenCompartir } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenUrl = imagen ? new URL(imagen, Astro.site) : undefined;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<link rel="canonical" href={canonica} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Vista al compartir en WhatsApp, Facebook y otras redes -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_PE" />
		<meta property="og:site_name" content={sitio.marca} />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={canonica} />
		{imagenUrl && <meta property="og:image" content={imagenUrl} />}
		<meta name="twitter:card" content={imagenUrl ? 'summary_large_image' : 'summary'} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&family=Manrope:wght@400;500;600&family=Plus+Jakarta+Sans:wght@800&family=Poppins:wght@600&display=swap"
		/>
		<slot name="head" />
		<!-- Va en el head para ocultar los bloques antes de pintar y evitar parpadeo -->
		<script is:inline>
			if ('IntersectionObserver' in window) document.documentElement.classList.add('con-js');
		</script>
	</head>
	<body>
		<slot />
		<script>
			// Muestra cada .revela una sola vez al entrar en pantalla; los que entran juntos salen escalonados.
			const observador = new IntersectionObserver(
				(entradas) => {
					entradas
						.filter((e) => e.isIntersecting)
						.forEach((e, i) => {
							const el = e.target as HTMLElement;
							el.style.setProperty('--retraso', `${i * 110}ms`);
							el.classList.add('visible');
							observador.unobserve(el);
						});
				},
				{ rootMargin: '0px 0px -20% 0px' },
			);
			document.querySelectorAll('.revela').forEach((el) => observador.observe(el));
		</script>
	</body>
</html>
