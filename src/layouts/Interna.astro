---
// Página interna del menú: cabecera, un título, el contenido y el pie con contacto.
import Base from './Base.astro';
import Cabecera from '../componentes/sitio/Cabecera.astro';
import Pie from '../componentes/sitio/Pie.astro';
import negocio from '../datos/negocio.json';

interface Props {
	titulo: string;
	descripcion: string;
	indexar?: boolean;
}
const { titulo, descripcion, indexar } = Astro.props;
---

<Base titulo={`${titulo} · ${negocio.marca}`} descripcion={descripcion} indexar={indexar}>
	<Cabecera />
	<main class="interna" id="contenido">
		<slot />
	</main>
	<Pie />
</Base>

<style>
	/* Las secciones traen su propio encabezado; aquí solo se separa un poco de la cabecera */
	.interna {
		padding-top: 24px;
		min-height: 60vh;
	}
</style>
