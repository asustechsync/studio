---
import { getCollection } from 'astro:content';
import { enlaceWhatsapp, precioEnSoles } from '../lib/enlaces';
import Icono from './Icono.astro';

const paquetes = (await getCollection('paquetes', ({ data }) => data.publicado)).sort(
	(a, b) => a.data.orden - b.data.orden,
);

const lineas = [
	{
		id: 'webs',
		titulo: 'Webs para tu negocio',
		texto: 'Para presentar tu negocio y recibir clientes por WhatsApp. El primer año de dominio y hosting va incluido.',
	},
	{
		id: 'tiendas',
		titulo: 'Tiendas online',
		texto: 'Para vender tus productos en línea, con panel para manejar tu catálogo.',
	},
] as const;
---

<section class="seccion" id="paquetes">
	<div class="contenedor">
		<div class="encabezado-seccion">
			<h2>Paquetes</h2>
			<p>Precio final, sin costos ocultos. Pagas 50 % al empezar y 50 % al entregar.</p>
		</div>

		{
			lineas.map((linea) => (
				<div class="linea">
					<div class="linea__encabezado">
						<h3>{linea.titulo}</h3>
						<p>{linea.texto}</p>
					</div>
					<div class="paquetes">
						{paquetes
							.filter(({ data }) => data.linea === linea.id)
							.map(({ data }) => (
					<article class:list={['paquete', { 'paquete--destacado': data.destacado }]}>
						<span class="paquete__etiqueta">{data.etiqueta}</span>
						<h4>{data.nombre}</h4>
						<div class="paquete__precio">
							{data.precioDesde && <span>desde</span>}
							<b>{precioEnSoles(data.precio)}</b>
						</div>
						<span class="paquete__plazo">
							Entrega en {data.plazo}
							{data.renovacion && <span class="paquete__renovacion">{data.renovacion}</span>}
						</span>

						<ul class="paquete__lista">
							{data.incluye.map((item) => (
								<li>
									<Icono nombre="check" tamano={16} />
									{item}
								</li>
							))}
						</ul>

						{data.noIncluye.length > 0 && (
							<ul class="paquete__lista paquete__lista--no">
								{data.noIncluye.map((item) => (
									<li>
										<Icono nombre="menos" tamano={16} />
										{item}
									</li>
								))}
							</ul>
						)}

						<a
							class:list={['boton', data.destacado ? 'boton--marca' : 'boton--claro', 'paquete__boton']}
							href={enlaceWhatsapp(`Hola, me interesa el paquete ${data.nombre}`)}
							target="_blank"
							rel="noopener"
						>
							Lo quiero
						</a>
					</article>
							))}
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.paquetes {
		display: grid;
		gap: 16px;
	}

	.paquete {
		display: flex;
		flex-direction: column;
		gap: 8px;
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
		border-radius: 14px;
		padding: 24px;
	}

	.paquete--destacado {
		border: 2px solid var(--color-marca);
	}

	.paquete__etiqueta {
		align-self: flex-start;
		font-size: 12px;
		font-weight: 600;
		color: var(--color-suave);
	}

	.paquete--destacado .paquete__etiqueta {
		background: var(--color-marca-suave);
		color: var(--color-marca);
		border-radius: var(--radio-chico);
		padding: 2px 10px;
	}

	.linea + .linea {
		margin-top: 56px;
	}

	.linea__encabezado {
		display: flex;
		flex-direction: column;
		gap: 4px;
		margin-bottom: 20px;
	}

	.linea__encabezado h3 {
		font-size: 22px;
	}

	.linea__encabezado p {
		color: var(--color-suave);
		font-size: 15px;
	}

	h4 {
		margin: 0;
		font-family: var(--tipo-titulos);
		font-weight: 600;
		font-size: 20px;
		line-height: 1.15;
	}

	.paquete__renovacion {
		display: block;
		font-size: 13px;
	}

	.paquete__precio {
		display: flex;
		align-items: baseline;
		gap: 6px;
		color: var(--color-suave);
		font-size: 14px;
	}

	.paquete__precio b {
		font-family: var(--tipo-titulos);
		font-size: 32px;
		font-weight: 600;
		color: var(--color-texto);
		font-variant-numeric: tabular-nums;
	}

	.paquete__plazo {
		font-size: 14px;
		color: var(--color-suave);
		padding-bottom: 12px;
		border-bottom: 1px solid var(--color-borde);
	}

	.paquete__lista {
		list-style: none;
		padding: 0;
		margin: 4px 0 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-size: 14px;
	}

	.paquete__lista li {
		display: flex;
		gap: 8px;
		align-items: flex-start;
	}

	.paquete__lista svg {
		flex: none;
		margin-top: 3px;
		color: var(--color-exito);
	}

	.paquete__lista--no {
		color: var(--color-suave);
	}

	.paquete__lista--no svg {
		color: var(--color-suave);
	}

	.paquete__lista:last-of-type {
		margin-bottom: 16px;
	}

	.paquete__boton {
		margin-top: auto;
		width: 100%;
	}

	@media (min-width: 640px) {
		.paquetes {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.paquetes {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
