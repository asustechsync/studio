---
// Soluciones de la portada, sin precios. Cada tarjeta lleva a la página de la solución, donde están los precios.
import { getCollection } from 'astro:content';
import { soluciones } from '../datos/soluciones';
import Icono from './Icono.astro';

const publicados = await getCollection('paquetes', ({ data }) => data.publicado);

const tarjetas = soluciones.map((solucion) => {
	const paquetes = publicados
		.filter(({ id }) => solucion.paquetes.includes(id))
		.sort((a, b) => a.data.orden - b.data.orden);
	return {
		...solucion,
		nombres: paquetes.map(({ data }) => data.nombre.replace(/^Web (\w)/, (_, c) => c.toUpperCase())),
		disponible: paquetes.length > 0,
		masPedido: paquetes.some(({ data }) => data.destacado),
	};
});
---

<section class="seccion soluciones-seccion" id="soluciones">
	<div class="contenedor">
		<div class="encabezado-seccion revela">
			<span class="antetitulo">Soluciones</span>
			<h2>Elige por dónde empezar a vender más</h2>
			<p>Tres caminos según lo que tu negocio necesita hoy. El precio final lo ves dentro de cada solución.</p>
		</div>

		<div class="soluciones">
			{
				tarjetas.map((s) => (
					<a class="solucion revela" href={`/soluciones/${s.slug}`}>
						<div class="arte" aria-hidden="true">
							{s.icono === 'mundo' && (
								<>
									<div class="ventana">
										<div class="ventana__puntos">
											<i />
											<i />
											<i />
										</div>
										<div class="linea linea--titulo" />
										<div class="linea" style="width:92%" />
										<div class="linea" style="width:60%" />
										<span class="ventana__boton">Cotizar</span>
									</div>
									<span class="flota">★ 4.9 · Abierto ahora</span>
								</>
							)}
							{s.icono === 'whatsapp' && (
								<div class="chat">
									<div class="burbuja burbuja--entra">Hola, ¿tienen polos básicos?</div>
									<div class="burbuja burbuja--sale">Sí, mira el catálogo</div>
									<div class="producto">
										<div class="producto__foto" />
										<div>
											<b>Polo básico</b>
											<span>S/ 39 · Pedir</span>
										</div>
									</div>
								</div>
							)}
							{s.icono === 'carrito' && (
								<>
									<div class="pedido">
										Pedido #1042
										<b>S/ 149</b>
										<span class="pedido__estado">
											<span class="estado estado--espera">Pendiente</span>
											<span class="estado estado--pago">✓ Pagado</span>
										</span>
									</div>
									<div class="barras">
										<i style="--h:40%" />
										<i style="--h:62%;animation-delay:0.15s" />
										<i style="--h:50%;animation-delay:0.3s" />
										<i style="--h:90%;animation-delay:0.45s" />
									</div>
									<span class="barras__texto">Ventas</span>
									<span class="flota flota--izq">+1 pedido</span>
								</>
							)}
							<span class="solucion__categoria">{s.categoria}</span>
							{s.masPedido && <span class="solucion__insignia">Más pedida</span>}
							{!s.disponible && <span class="solucion__insignia">Próximamente</span>}
						</div>
						<div class="solucion__cuerpo">
							<div class="solucion__fila">
								<h3>{s.nombre}</h3>
								<span class="solucion__flecha">
									<Icono nombre="flecha" tamano={16} />
								</span>
							</div>
							<p>{s.resumen}</p>
							{s.nombres.length > 0 && (
								<ul class="solucion__niveles">
									{s.nombres.map((n) => (
										<li>{n}</li>
									))}
								</ul>
							)}
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.soluciones-seccion {
		background:
			radial-gradient(ellipse 70% 320px at 50% 0, rgb(217 119 87 / 0.09), transparent 70%),
			var(--color-fondo);
	}

	.soluciones {
		display: grid;
		gap: 18px;
	}

	.solucion {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		text-decoration: none;
		color: var(--color-texto);
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
		border-radius: 18px;
		box-shadow: var(--sombra-suave);
		transition: translate 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
	}

	.solucion:hover {
		translate: 0 -4px;
		border-color: rgb(255 255 255 / 0.18);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.4), 0 22px 44px -16px rgb(0 0 0 / 0.7);
	}

	.solucion:focus-visible {
		outline: 2px solid var(--color-marca);
		outline-offset: 3px;
	}

	/* Mini pantallas animadas: solo CSS, sin JavaScript */
	.arte {
		position: relative;
		height: 250px;
		overflow: hidden;
		border-bottom: 1px solid var(--color-borde);
		background-color: var(--color-fondo);
		background-image:
			linear-gradient(rgb(255 255 255 / 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgb(255 255 255 / 0.03) 1px, transparent 1px);
		background-size: 22px 22px;
		font-size: 12px;
		color: var(--color-texto);
	}

	.ventana {
		position: absolute;
		left: 50%;
		top: 56px;
		translate: -50% 0;
		width: min(76%, 280px);
		padding: 14px;
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
		border-radius: 10px;
	}

	.ventana__puntos {
		display: flex;
		gap: 4px;
		margin-bottom: 10px;
	}

	.ventana__puntos i {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--color-borde);
	}

	.linea {
		height: 9px;
		margin-top: 9px;
		border-radius: 4px;
		background: var(--color-borde);
	}

	.linea--titulo {
		width: 70%;
		margin-top: 0;
		background: var(--color-texto);
		opacity: 0.85;
	}

	.ventana__boton {
		display: inline-block;
		margin-top: 14px;
		font-size: 13px;
		padding: 5px 14px;
		border-radius: 6px;
		font-weight: 600;
		color: var(--color-fondo);
		background: var(--color-marca);
		animation: pulso 2s infinite;
	}

	.flota {
		position: absolute;
		right: 14px;
		bottom: 14px;
		font-size: 12px;
		padding: 3px 10px;
		border-radius: 999px;
		color: var(--color-marca-texto);
		background: var(--color-fondo);
		border: 1px solid var(--color-marca);
		animation: flota 3.5s ease-in-out infinite;
	}

	.flota--izq {
		left: 22px;
		right: auto;
	}

	.chat {
		position: absolute;
		inset: 0;
		padding: 58px 22px 0;
	}

	.burbuja {
		width: fit-content;
		max-width: 80%;
		margin-bottom: 9px;
		font-size: 13px;
		padding: 9px 14px;
		border-radius: 12px;
		line-height: 1.35;
		opacity: 0;
	}

	.burbuja--entra {
		background: var(--color-borde);
		border-bottom-left-radius: 3px;
		animation: msg1 7s infinite;
	}

	.burbuja--sale {
		margin-left: auto;
		background: var(--color-marca-suave);
		border: 1px solid rgb(217 119 87 / 0.35);
		border-bottom-right-radius: 3px;
		animation: msg2 7s infinite;
	}

	.producto {
		display: flex;
		align-items: center;
		gap: 11px;
		width: fit-content;
		font-size: 13px;
		padding: 9px 12px;
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
		border-radius: 10px;
		opacity: 0;
		animation: msg3 7s infinite;
	}

	.producto b {
		display: block;
		font-weight: 600;
	}

	.producto span {
		color: var(--color-marca-texto);
	}

	.producto__foto {
		flex: none;
		width: 38px;
		height: 38px;
		border-radius: 7px;
		background: linear-gradient(160deg, #3a2a22, var(--color-marca));
	}

	.pedido {
		position: absolute;
		left: 22px;
		top: 58px;
		width: 150px;
		padding: 12px;
		color: var(--color-suave);
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
		border-radius: 10px;
	}

	.pedido b {
		display: block;
		margin: 2px 0 8px;
		font-family: var(--tipo-titulos);
		font-size: 24px;
		font-weight: 600;
		color: var(--color-texto);
	}

	.pedido__estado {
		position: relative;
		display: block;
		height: 20px;
	}

	.estado {
		position: absolute;
		left: 0;
		padding: 1px 8px;
		border-radius: 999px;
	}

	.estado--espera {
		background: var(--color-borde);
		animation: estado-a 5s infinite;
	}

	.estado--pago {
		color: var(--color-exito);
		background: rgb(94 194 143 / 0.15);
		animation: estado-b 5s infinite;
	}

	.barras {
		position: absolute;
		right: 26px;
		top: 62px;
		display: flex;
		align-items: flex-end;
		gap: 9px;
		width: 112px;
		height: 112px;
		border-bottom: 1px solid var(--color-borde);
	}

	.barras i {
		flex: 1;
		height: var(--h);
		border-radius: 3px 3px 0 0;
		background: var(--color-marca);
		transform-origin: bottom;
		animation: crece 5s ease-in-out infinite;
	}

	.barras__texto {
		position: absolute;
		right: 26px;
		top: 182px;
		width: 112px;
		text-align: center;
		color: var(--color-suave);
	}

	.solucion__insignia {
		z-index: 1;
	}

	@keyframes pulso {
		0%, 100% { box-shadow: 0 0 0 0 rgb(217 119 87 / 0.5); }
		50% { box-shadow: 0 0 0 7px rgb(217 119 87 / 0); }
	}

	@keyframes flota {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-6px); }
	}

	@keyframes msg1 {
		0% { opacity: 0; transform: translateY(8px); }
		6%, 90% { opacity: 1; transform: none; }
		97%, 100% { opacity: 0; }
	}

	@keyframes msg2 {
		0%, 14% { opacity: 0; transform: translateY(8px); }
		20%, 90% { opacity: 1; transform: none; }
		97%, 100% { opacity: 0; }
	}

	@keyframes msg3 {
		0%, 30% { opacity: 0; transform: translateY(8px); }
		36%, 90% { opacity: 1; transform: none; }
		97%, 100% { opacity: 0; }
	}

	@keyframes estado-a {
		0%, 35% { opacity: 1; }
		45%, 90% { opacity: 0; }
		100% { opacity: 1; }
	}

	@keyframes estado-b {
		0%, 35% { opacity: 0; }
		45%, 90% { opacity: 1; }
		100% { opacity: 0; }
	}

	@keyframes crece {
		0%, 8% { transform: scaleY(0.15); }
		45%, 85% { transform: scaleY(1); }
		100% { transform: scaleY(0.15); }
	}

	/* Sin movimiento: se muestra el estado final, quieto */
	@media (prefers-reduced-motion: reduce) {
		.ventana__boton,
		.flota,
		.burbuja,
		.producto,
		.estado,
		.barras i {
			animation: none;
		}

		.burbuja,
		.producto {
			opacity: 1;
		}

		.estado--espera {
			opacity: 0;
		}
	}

	.solucion__insignia {
		position: absolute;
		top: 12px;
		right: 12px;
		font-size: 12px;
		font-weight: 600;
		color: var(--color-marca-texto);
		background: var(--color-fondo);
		border: 1px solid var(--color-marca);
		border-radius: 999px;
		padding: 3px 12px;
	}

	.solucion__cuerpo {
		display: flex;
		flex-direction: column;
		gap: 4px;
		flex: 1;
		padding: 16px 20px 20px;
	}

	.solucion__categoria {
		position: absolute;
		top: 12px;
		left: 12px;
		z-index: 1;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-marca-texto);
		background: var(--color-fondo);
		border: 1px solid rgb(217 119 87 / 0.35);
		border-radius: 999px;
		padding: 3px 12px;
	}

	.solucion__fila {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
	}

	.solucion__flecha {
		flex: none;
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		color: var(--color-marca-texto);
		border: 1px solid rgb(217 119 87 / 0.35);
		border-radius: 50%;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.solucion:hover .solucion__flecha {
		color: var(--color-fondo);
		background: var(--color-marca);
	}

	h3 {
		margin: 0;
		font-family: var(--tipo-titulos);
		font-weight: 600;
		font-size: 18px;
		line-height: 1.2;
	}

	p {
		margin: 0;
		font-size: 14px;
		color: var(--color-suave);
	}

	.solucion__niveles {
		display: flex;
		flex-wrap: nowrap;
		gap: 6px;
		list-style: none;
		padding: 0;
		margin: 8px 0 0;
	}

	.solucion__niveles li {
		font-size: 11px;
		white-space: nowrap;
		color: var(--color-suave);
		background: var(--color-fondo);
		border: 1px solid var(--color-borde);
		border-radius: 6px;
		padding: 2px 8px;
	}

	@media (prefers-reduced-motion: reduce) {
		.solucion {
			transition: none;
		}
	}

	@media (min-width: 720px) {
		.soluciones {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
