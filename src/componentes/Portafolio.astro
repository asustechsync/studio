---
import { getCollection } from 'astro:content';
import Icono from './Icono.astro';

const proyectos = (await getCollection('proyectos', ({ data }) => data.publicado)).sort(
	(a, b) => a.data.orden - b.data.orden,
);
// Fondos de reserva con los tonos del atardecer de la portada
const tonos = [
	'linear-gradient(160deg, #1d1c1a, #3a2a22 55%, #d97757)',
	'linear-gradient(160deg, #3a2a22, #a85a3d 65%, #e8a47f)',
	'linear-gradient(160deg, #0f0e0d, #1d1c1a 55%, #2a221e)',
	'linear-gradient(160deg, #2a221e, #8a4a33 70%, #d97757)',
];
---

{/* Sin proyectos publicados, el bloque entero se oculta: así no mostramos trabajos que no existen */}
{proyectos.length > 0 && (
<section class="seccion portafolio" id="portafolio">
	<div class="contenedor">
		<div class="encabezado-seccion revela">
			<span class="antetitulo">Ejemplos</span>
			<h2>Portafolio</h2>
			<p>Ejemplos de lo que podemos construir para tu negocio.</p>
		</div>

		<div class="proyectos">
			{
				proyectos.map(({ data }, i) => (
					<article class="proyecto revela">
						<div class="proyecto__marco">
							{data.imagen ? (
								<img class="proyecto__imagen" src={data.imagen} alt={data.titulo} loading="lazy" />
							) : (
								<div class="proyecto__imagen" style={`background:${tonos[i % tonos.length]}`} />
							)}
						</div>
						<div class="proyecto__texto">
							<h3>{data.titulo}</h3>
							<p>{data.descripcion}</p>
							<div class="proyecto__etiquetas">
								{data.tecnologias.map((t) => <span>{t}</span>)}
							</div>
							{data.enlace && (
								<a class="proyecto__enlace" href={data.enlace} target="_blank" rel="noopener">
									Ver proyecto
									<Icono nombre="enlace" tamano={16} />
								</a>
							)}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
)}

<style>
	.portafolio {
		background: var(--color-fondo);
	}

	.proyectos {
		display: grid;
		gap: 18px;
	}

	.proyecto {
		border: 1px solid var(--color-borde);
		border-radius: 18px;
		overflow: hidden;
		background: var(--color-superficie);
		box-shadow: var(--sombra-suave);
		transition: translate 0.25s ease, box-shadow 0.25s ease;
	}

	.proyecto:hover {
		translate: 0 -4px;
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.4), 0 22px 44px -16px rgb(0 0 0 / 0.7);
	}

	.proyecto__marco {
		overflow: hidden;
	}

	.proyecto__imagen {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		transition: scale 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.proyecto:hover .proyecto__imagen {
		scale: 1.04;
	}

	@media (prefers-reduced-motion: reduce) {
		.proyecto,
		.proyecto__imagen {
			transition: none;
		}
	}

	.proyecto__texto {
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	h3 {
		font-size: 18px;
	}

	.proyecto__texto p {
		color: var(--color-suave);
		font-size: 14px;
	}

	.proyecto__etiquetas {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.proyecto__etiquetas span {
		font-size: 12px;
		font-weight: 500;
		background: var(--color-marca-suave);
		border-radius: 999px;
		padding: 2px 10px;
		color: var(--color-marca-texto);
	}

	.proyecto__enlace {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-weight: 600;
		font-size: 14px;
		color: var(--color-marca-texto);
		text-decoration: none;
	}

	@media (min-width: 640px) {
		.proyectos {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.proyectos {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
