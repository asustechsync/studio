---
import sitio from '../datos/sitio.json';

const { preguntas } = sitio;
---

<section class="seccion" id="preguntas">
	<div class="contenedor preguntas">
		<div class="encabezado-seccion revela">
			<span class="antetitulo">Dudas frecuentes</span>
			<h2>Preguntas frecuentes</h2>
			<p>Lo que casi todos preguntan antes de empezar.</p>
		</div>

		<!-- details/summary: se abre y cierra sin JavaScript y funciona con teclado -->
		<div class="lista revela">
			{
				preguntas.map((q, i) => (
					<details class="pregunta" open={i === 0}>
						<summary>
							{q.p}
							<span class="pregunta__signo" aria-hidden="true"></span>
						</summary>
						<p>{q.r}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.preguntas {
		max-width: 760px;
	}

	.lista {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.pregunta {
		border-radius: 16px;
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
		box-shadow: var(--sombra-suave);
		transition: border-color 0.2s ease;
	}

	.pregunta[open] {
		border-color: rgb(217 119 87 / 0.5);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 18px 20px;
		cursor: pointer;
		list-style: none;
		font-family: var(--tipo-titulos);
		font-weight: 600;
		font-size: 16px;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	/* Signo + que gira a × al abrir */
	.pregunta__signo {
		position: relative;
		flex: none;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: var(--color-marca-suave);
		transition: rotate 0.25s ease;
	}

	.pregunta__signo::before,
	.pregunta__signo::after {
		content: '';
		position: absolute;
		inset: 50% auto auto 50%;
		width: 12px;
		height: 2px;
		margin: -1px 0 0 -6px;
		border-radius: 2px;
		background: var(--color-marca);
	}

	.pregunta__signo::after {
		rotate: 90deg;
	}

	.pregunta[open] .pregunta__signo {
		rotate: 45deg;
	}

	.pregunta p {
		padding: 0 20px 20px;
		color: var(--color-suave);
		font-size: 15px;
		max-width: 62ch;
	}

	@media (prefers-reduced-motion: reduce) {
		.pregunta,
		.pregunta__signo {
			transition: none;
		}
	}
</style>
