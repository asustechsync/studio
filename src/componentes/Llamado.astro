---
import sitio from '../datos/sitio.json';
import { enlaceWhatsapp } from '../lib/enlaces';
import Icono from './Icono.astro';

const { llamado } = sitio;
const anio = new Date().getFullYear();

// Los mismos cerros de la portada cierran la página, en tonos oscuros que terminan en el pie.
const cerros = [
	{ color: '#241d19', d: 'M0 120 C160 70 300 100 420 64 C560 22 660 84 800 50 C940 16 1060 76 1200 42 C1300 18 1380 50 1440 34 V160 H0Z' },
	{ color: '#1c1815', d: 'M0 138 C120 100 260 128 380 92 C500 58 600 118 740 88 C880 58 980 110 1120 80 C1260 50 1360 102 1440 80 V160 H0Z' },
	{ color: '#161311', d: 'M0 152 C180 118 300 144 460 124 C620 104 720 144 900 124 C1060 108 1200 144 1440 118 V160 H0Z' },
	{ color: '#0f0e0d', d: 'M0 160 C240 140 480 156 720 146 C960 136 1200 154 1440 142 V160 H0Z' },
];
---

<footer class="llamado">
	<div class="llamado__cerros" aria-hidden="true">
		{
			cerros.map((c) => (
				<svg viewBox="0 0 1440 160" preserveAspectRatio="none">
					<path d={c.d} fill={c.color} />
				</svg>
			))
		}
	</div>

	<div class="contenedor llamado__fila revela">
		<div class="llamado__texto">
			<h2>{llamado.titulo}</h2>
			<p>{llamado.texto}</p>
		</div>
		<a
			class="boton boton--crema llamado__boton"
			href={enlaceWhatsapp(`Hola, quiero el diagnóstico gratis de mi web`)}
			target="_blank"
			rel="noopener"
		>
			<Icono nombre="whatsapp" />
			{llamado.boton}
		</a>
	</div>
	<div class="contenedor llamado__pie">
		<span>{sitio.marca} · {sitio.ciudad}</span>
		<span>{sitio.correo}</span>
		<span>© {anio}</span>
	</div>
</footer>

<style>
	.llamado {
		background: var(--color-oscuro);
		color: var(--color-oscuro-texto);
		padding-bottom: 24px;
	}

	/* Franja de cerros: arranca en el color de la página y termina en el pie */
	.llamado__cerros {
		position: relative;
		height: 110px;
		background: linear-gradient(180deg, var(--color-fondo) 0%, #1d1712 100%);
	}

	.llamado__cerros svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.llamado__fila {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 22px;
		padding-block: 40px 48px;
		border-bottom: 1px solid rgb(255 255 255 / 0.1);
	}

	.llamado__texto {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
	}

	h2 {
		color: #fff;
		font-size: 28px;
		letter-spacing: -0.02em;
		max-width: 22ch;
	}

	.llamado__texto p {
		font-size: 17px;
		color: rgb(255 255 255 / 0.74);
	}

	.llamado__boton {
		min-height: 46px;
		padding-inline: 20px;
		border-radius: 12px;
	}

	.llamado__pie {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px 24px;
		padding-top: 20px;
		font-size: 13px;
		color: #8a867d;
	}

	@media (min-width: 768px) {
		.llamado__cerros {
			height: 150px;
		}

		h2 {
			font-size: 40px;
		}
	}
</style>
