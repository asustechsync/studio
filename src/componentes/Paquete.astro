---
// Tarjeta de un paquete con su precio. Se usa en la página de cada solución.
import type { CollectionEntry } from 'astro:content';
import { enlaceWhatsapp, precioEnSoles } from '../lib/enlaces';
import Icono from './Icono.astro';

interface Props {
	data: CollectionEntry<'paquetes'>['data'];
}

const { data } = Astro.props;
---

<article class:list={['paquete', 'revela', { 'paquete--destacado': data.destacado }]}>
	<span class="paquete__etiqueta">{data.etiqueta}</span>
	<h2>{data.nombre}</h2>
	<div class="paquete__precio">
		{data.precioDesde && <span>desde</span>}
		<b>{precioEnSoles(data.precio)}</b>
	</div>
	<span class="paquete__plazo">
		Entrega en {data.plazo}
		{data.renovacion && <span class="paquete__renovacion">{data.renovacion}</span>}
	</span>

	<ul class="paquete__lista">
		{
			data.incluye.map((item) => (
				<li>
					<Icono nombre="check" tamano={16} />
					{item}
				</li>
			))
		}
	</ul>

	{
		data.noIncluye.length > 0 && (
			<ul class="paquete__lista paquete__lista--no">
				{data.noIncluye.map((item) => (
					<li>
						<Icono nombre="menos" tamano={16} />
						{item}
					</li>
				))}
			</ul>
		)
	}

	<a
		class:list={['boton', data.destacado ? 'boton--crema' : 'boton--claro', 'paquete__boton']}
		href={enlaceWhatsapp(`Hola, me interesa el paquete ${data.nombre}`)}
		target="_blank"
		rel="noopener"
	>
		Lo quiero
	</a>
</article>

<style>
	.paquete {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
		border-radius: 18px;
		padding: 26px;
		box-shadow: var(--sombra-suave);
		transition: translate 0.25s ease, box-shadow 0.25s ease;
	}

	.paquete:hover {
		translate: 0 -4px;
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.4), 0 22px 44px -16px rgb(0 0 0 / 0.7);
	}

	/* El destacado lleva el cielo de la portada */
	.paquete--destacado {
		--color-texto: #fff;
		--color-suave: rgb(255 255 255 / 0.72);
		--color-borde: rgb(255 255 255 / 0.14);
		--color-exito: var(--cielo-arena);
		color: #fff;
		background:
			radial-gradient(circle at 50% 120%, rgb(217 119 87 / 0.3), transparent 55%),
			var(--degradado-cielo);
		border-color: rgb(217 119 87 / 0.55);
		box-shadow: 0 24px 48px -18px rgb(217 119 87 / 0.25);
	}

	.paquete__etiqueta {
		align-self: flex-start;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--color-marca-texto);
		background: var(--color-marca-suave);
		border-radius: 999px;
		padding: 3px 12px;
	}

	.paquete--destacado .paquete__etiqueta {
		color: #fff;
		background: rgb(255 255 255 / 0.1);
		border: 1px solid rgb(255 255 255 / 0.2);
	}

	h2 {
		margin: 0;
		font-family: var(--tipo-titulos);
		font-weight: 600;
		font-size: 20px;
		line-height: 1.15;
	}

	.paquete__renovacion {
		display: block;
		font-size: 13px;
	}

	.paquete__precio {
		display: flex;
		align-items: baseline;
		gap: 6px;
		color: var(--color-suave);
		font-size: 14px;
	}

	.paquete__precio b {
		font-family: var(--tipo-titulos);
		font-size: 32px;
		font-weight: 600;
		color: var(--color-texto);
		font-variant-numeric: tabular-nums;
	}

	.paquete__plazo {
		font-size: 14px;
		color: var(--color-suave);
		padding-bottom: 12px;
		border-bottom: 1px solid var(--color-borde);
	}

	.paquete__lista {
		list-style: none;
		padding: 0;
		margin: 4px 0 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-size: 14px;
	}

	.paquete__lista li {
		display: flex;
		gap: 8px;
		align-items: flex-start;
	}

	.paquete__lista svg {
		flex: none;
		margin-top: 3px;
		color: var(--color-exito);
	}

	.paquete__lista--no {
		color: var(--color-suave);
	}

	.paquete__lista--no svg {
		color: var(--color-suave);
	}

	.paquete__lista:last-of-type {
		margin-bottom: 16px;
	}

	.paquete__boton {
		margin-top: auto;
		width: 100%;
	}

	@media (prefers-reduced-motion: reduce) {
		.paquete {
			transition: none;
		}
	}
</style>
