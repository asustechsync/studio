---
import sitio from '../datos/sitio.json';
import Icono from './Icono.astro';

const { garantias, tecnologias } = sitio;
---

<section class="garantias" aria-label="Garantías">
	<div class="contenedor">
		<ul class="garantias__lista">
			{
				garantias.map((g) => (
					<li class="garantia revela">
						<span class="garantia__icono">
							<Icono nombre={g.icono as 'rayo' | 'escudo' | 'calendario'} tamano={22} />
						</span>
						<div>
							<h3>{g.titulo}</h3>
							<p>{g.texto}</p>
						</div>
					</li>
				))
			}
		</ul>

		<div class="tecnologias revela">
			<span class="tecnologias__titulo">Con lo que trabajamos</span>
			<ul>
				{tecnologias.map((t) => <li>{t}</li>)}
			</ul>
		</div>
	</div>
</section>

<style>
	.garantias {
		padding-block: 40px 8px;
		background: var(--color-fondo);
	}

	.garantias__lista {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 14px;
	}

	.garantia {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 18px 20px;
		border-radius: 18px;
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
		box-shadow: var(--sombra-suave);
	}

	.garantia__icono {
		flex: none;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		color: var(--color-marca);
		background: var(--color-marca-suave);
	}

	h3 {
		font-size: 16px;
	}

	.garantia p {
		color: var(--color-suave);
		font-size: 14px;
		margin-top: 2px;
	}

	.tecnologias {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		margin-top: 32px;
	}

	.tecnologias__titulo {
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-suave);
	}

	.tecnologias ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
	}

	.tecnologias li {
		font-size: 14px;
		font-weight: 500;
		padding: 6px 16px;
		border-radius: 999px;
		color: var(--color-suave);
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
	}

	@media (min-width: 768px) {
		.garantias {
			padding-block: 56px 16px;
		}

		.garantias__lista {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
