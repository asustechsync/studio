---
// Tarjeta de un paquete con su precio. Se usa en la página de cada solución.
import type { CollectionEntry } from 'astro:content';
import { enlaceWhatsapp, precioEnSoles } from '../../lib/enlaces';
import Icono from './Icono.astro';

interface Props {
	data: CollectionEntry<'paquetes'>['data'];
}

const { data } = Astro.props;
---

<article class:list={['paquete', 'tarjeta', 'tarjeta--elevable', 'revela', { 'paquete--destacado': data.destacado }]}>
	<span class="paquete__etiqueta">{data.etiqueta}</span>
	<h2>{data.nombre}</h2>
	<div class="paquete__precio">
		{data.precioDesde && <span>desde</span>}
		<b>{precioEnSoles(data.precio)}</b>
	</div>
	<span class="paquete__plazo">
		Entrega en {data.plazo}
		{data.renovacion && <span class="paquete__renovacion">{data.renovacion}</span>}
	</span>

	<ul class="paquete__lista">
		{
			data.incluye.map((item) => (
				<li>
					<Icono nombre="check" tamano={16} />
					{item}
				</li>
			))
		}
	</ul>

	{
		data.noIncluye.length > 0 && (
			<ul class="paquete__lista paquete__lista--no">
				{data.noIncluye.map((item) => (
					<li>
						<Icono nombre="menos" tamano={16} />
						{item}
					</li>
				))}
			</ul>
		)
	}

	<a
		class:list={['boton', data.destacado ? 'boton--crema' : 'boton--claro', 'paquete__boton']}
		href={enlaceWhatsapp(`Hola, me interesa el paquete ${data.nombre}`)}
		target="_blank"
		rel="noopener noreferrer"
	>
		Lo quiero
	</a>
</article>

<style>
	.paquete {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 26px;
	}

	/* El destacado lleva el cielo de la portada */
	.paquete--destacado {
		--color-texto: var(--color-blanco);
		--color-suave: color-mix(in srgb, var(--color-blanco) 72%, transparent);
		--color-borde: color-mix(in srgb, var(--color-blanco) 14%, transparent);
		--color-exito: var(--cielo-arena);
		color: var(--color-blanco);
		background:
			radial-gradient(circle at 50% 120%, color-mix(in srgb, var(--color-marca) 30%, transparent), transparent 55%),
			var(--degradado-cielo);
		border-color: color-mix(in srgb, var(--color-marca) 55%, transparent);
		box-shadow: 0 24px 48px -18px color-mix(in srgb, var(--color-marca) 25%, transparent);
	}

	.paquete__etiqueta {
		align-self: flex-start;
		font-size: var(--texto-xs);
		font-weight: 600;
		letter-spacing: 0.03em;
		color: var(--color-marca-texto);
		background: var(--color-marca-suave);
		border-radius: var(--radio-sm);
		padding: 4px 10px;
	}

	.paquete--destacado .paquete__etiqueta {
		color: var(--color-blanco);
		background: color-mix(in srgb, var(--color-blanco) 10%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-blanco) 20%, transparent);
	}

	h2 {
		margin: 0;
		font-family: var(--tipo-titulos);
		font-weight: 600;
		font-size: var(--texto-2xl);
		line-height: 1.15;
	}

	.paquete__renovacion {
		display: block;
		font-size: var(--texto-sm);
	}

	.paquete__precio {
		display: flex;
		align-items: baseline;
		gap: 6px;
		color: var(--color-suave);
		font-size: var(--texto-md);
	}

	.paquete__precio b {
		font-family: var(--tipo-titulos);
		font-size: var(--titulo-sm);
		font-weight: 600;
		color: var(--color-texto);
		font-variant-numeric: tabular-nums;
	}

	.paquete__plazo {
		font-size: var(--texto-md);
		color: var(--color-suave);
		padding-bottom: 12px;
		border-bottom: 1px solid var(--color-borde);
	}

	.paquete__lista {
		list-style: none;
		padding: 0;
		margin: 4px 0 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-size: var(--texto-md);
	}

	.paquete__lista li {
		display: flex;
		gap: 8px;
		align-items: flex-start;
	}

	.paquete__lista svg {
		flex: none;
		margin-top: 3px;
		color: var(--color-exito);
	}

	.paquete__lista--no {
		color: var(--color-suave);
	}

	.paquete__lista--no svg {
		color: var(--color-suave);
	}

	.paquete__lista:last-of-type {
		margin-bottom: 16px;
	}

	.paquete__boton {
		margin-top: auto;
		width: 100%;
	}

	@media (prefers-reduced-motion: reduce) {
		.paquete {
			transition: none;
		}
	}
</style>
