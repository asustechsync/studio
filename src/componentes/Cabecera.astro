---
import sitio from '../datos/sitio.json';
import { enlaceWhatsapp } from '../lib/enlaces';
import Icono from './Icono.astro';

const enlaces = [
	{ texto: 'Paquetes', href: '#paquetes' },
	{ texto: 'Portafolio', href: '#portafolio' },
	{ texto: 'Cómo trabajo', href: '#proceso' },
];
---

<header class="cabecera">
	<div class="contenedor cabecera__fila">
		<a class="cabecera__marca" href="/">
			<span class="cabecera__logo" aria-hidden="true">{sitio.marca.slice(0, 1)}</span>
			{sitio.marca}
		</a>
		<nav class="cabecera__menu" aria-label="Principal">
			{enlaces.map((e) => <a href={e.href}>{e.texto}</a>)}
		</nav>
		<a class="boton boton--whatsapp cabecera__boton" href={enlaceWhatsapp()} target="_blank" rel="noopener">
			<Icono nombre="whatsapp" />
			<span>WhatsApp</span>
		</a>
	</div>
</header>

<style>
	/* Cabecera de vidrio oscuro: legible sobre la portada y sobre las secciones claras.
	   Donde el navegador lo permite, empieza transparente y se oscurece al hacer scroll. */
	.cabecera {
		position: sticky;
		top: 0;
		z-index: 10;
		color: #fff;
		background: rgb(14 20 36 / 0.82);
		backdrop-filter: saturate(1.4) blur(12px);
		border-bottom: 1px solid rgb(255 255 255 / 0.08);
	}

	@supports (animation-timeline: scroll()) {
		.cabecera {
			animation: cabecera-oscurece linear both;
			animation-timeline: scroll(root);
			animation-range: 0px 160px;
		}
	}

	@keyframes cabecera-oscurece {
		from {
			background: rgb(14 20 36 / 0);
			border-bottom-color: transparent;
			backdrop-filter: none;
		}
	}

	.cabecera__fila {
		display: flex;
		align-items: center;
		gap: 16px;
		min-height: 64px;
	}

	.cabecera__marca {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-right: auto;
		font-family: var(--tipo-titulos);
		font-weight: 600;
		font-size: 18px;
		text-decoration: none;
	}

	.cabecera__logo {
		display: inline-grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 8px;
		background: var(--color-marca);
		color: #fff;
		font-size: 15px;
	}

	.cabecera__menu {
		display: none;
	}

	.cabecera__boton {
		min-height: 40px;
		padding: 8px 14px;
		font-size: 14px;
	}

	@media (min-width: 768px) {
		.cabecera__menu {
			display: flex;
			gap: 4px;
			padding: 4px;
			font-size: 14px;
			border-radius: 999px;
			background: rgb(255 255 255 / 0.08);
			border: 1px solid rgb(255 255 255 / 0.14);
		}

		.cabecera__menu a {
			text-decoration: none;
			padding: 6px 14px;
			border-radius: 999px;
			color: rgb(255 255 255 / 0.78);
		}

		.cabecera__menu a:hover {
			color: #fff;
			background: rgb(255 255 255 / 0.1);
		}
	}
</style>
