---
import sitio from '../datos/sitio.json';
import { enlaceWhatsapp } from '../lib/enlaces';
import { getCollection } from 'astro:content';
import Icono from './Icono.astro';

const hayProyectos = (await getCollection('proyectos', ({ data }) => data.publicado)).length > 0;

const ruta = Astro.url.pathname.replace(/\/$/, '');
const enSoluciones = ruta.startsWith('/soluciones');
const enlaces = [
	{ texto: 'Soluciones', href: '/soluciones' },
	...(hayProyectos ? [{ texto: 'Portafolio', href: '/portafolio' }] : []),
	{ texto: 'Contacto', href: '/contacto' },
];
---

<header class="cabecera">
	<div class="contenedor cabecera__fila">
		<a class="cabecera__marca" href="/">
			<span class="cabecera__logo" aria-hidden="true">{sitio.marca.slice(0, 1)}</span>
			{sitio.marca}
		</a>
		<nav class="cabecera__menu" aria-label="Principal">
			{enlaces.map((e) => <a href={e.href} aria-current={(e.href === '/soluciones' ? enSoluciones : ruta === e.href) ? 'page' : undefined}>{e.texto}</a>)}
		</nav>
		<a class="boton boton--whatsapp cabecera__boton" href={enlaceWhatsapp()} target="_blank" rel="noopener">
			<Icono nombre="whatsapp" />
			<span>WhatsApp</span>
		</a>
		<details class="movil">
			<summary aria-label="Menú"><span></span></summary>
			<div class="movil__panel">
				{enlaces.map((e) => <a href={e.href}>{e.texto}</a>)}
			</div>
		</details>
	</div>
</header>

<style>
	/* Cabecera de vidrio oscuro: legible sobre la portada y sobre las secciones claras.
	   Donde el navegador lo permite, empieza transparente y se oscurece al hacer scroll. */
	.cabecera {
		position: sticky;
		top: 0;
		z-index: 10;
		color: var(--color-texto);
		background: rgb(20 20 19 / 0.85);
		backdrop-filter: saturate(1.4) blur(12px);
		/* Altura fija que incluye el borde: la portada se sube exactamente esto */
		height: var(--alto-cabecera);
		border-bottom: 1px solid rgb(255 255 255 / 0.08);
	}

	@supports (animation-timeline: scroll()) {
		.cabecera {
			animation: cabecera-oscurece linear both;
			animation-timeline: scroll(root);
			animation-range: 0px 160px;
		}
	}

	@keyframes cabecera-oscurece {
		from {
			background: rgb(20 20 19 / 0);
			border-bottom-color: transparent;
			backdrop-filter: none;
		}
	}

	/* Tres columnas: marca a la izquierda, menú realmente centrado, botón a la derecha */
	.cabecera__fila {
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: center;
		gap: 16px;
		height: 100%;
	}

	.cabecera__marca {
		display: flex;
		align-items: center;
		gap: 10px;
		justify-self: start;
		font-family: var(--tipo-titulos);
		font-weight: 600;
		font-size: 18px;
		text-decoration: none;
	}

	.cabecera__logo {
		display: inline-grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 8px;
		background: var(--color-marca);
		color: #141413;
		font-size: 15px;
	}

	.cabecera__menu {
		display: none;
	}

	.cabecera__boton {
		min-height: 40px;
		padding: 8px 14px;
		font-size: 14px;
	}

	.cabecera__boton {
		justify-self: end;
	}

	@media (min-width: 768px) {
		.cabecera__fila {
			grid-template-columns: 1fr auto 1fr;
		}

		/* Menú sin fondo ni borde: solo texto sobre el cielo */
		.cabecera__menu {
			display: flex;
			gap: 8px;
			font-size: 15px;
		}

		.cabecera__menu a {
			text-decoration: none;
			padding: 6px 14px;
			color: var(--color-suave);
			transition: color 0.2s ease;
		}

		.cabecera__menu a:hover {
			color: var(--color-texto);
		}
	}

	.cabecera__menu a[aria-current='page'] {
		color: var(--color-marca-texto);
	}

	/* Menú de celular: tres rayas que abren una lista */
	.movil {
		position: static;
	}

	.movil summary {
		list-style: none;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		cursor: pointer;
		border: 1px solid rgb(255 255 255 / 0.14);
		border-radius: 10px;
	}

	.movil summary::-webkit-details-marker {
		display: none;
	}

	.movil summary span,
	.movil summary span::before {
		display: block;
		width: 18px;
		height: 2px;
		border-radius: 2px;
		background: var(--color-texto);
	}

	.movil summary span {
		position: relative;
	}

	.movil summary span::before {
		content: '';
		position: absolute;
		top: 6px;
	}

	.movil summary span::after {
		content: '';
		position: absolute;
		top: -6px;
		width: 18px;
		height: 2px;
		border-radius: 2px;
		background: var(--color-texto);
	}

	.movil__panel {
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		display: flex;
		flex-direction: column;
		padding: 12px 16px 16px;
		background: #141413;
		border-bottom: 1px solid #3d3a34;
	}

	.movil__panel a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 12px 0;
		border-bottom: 1px solid rgb(255 255 255 / 0.07);
		text-decoration: none;
		color: var(--color-texto);
	}

	@media (min-width: 768px) {
		.movil {
			display: none;
		}
	}
</style>
