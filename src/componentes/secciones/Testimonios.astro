---
import textos from '../../datos/textos.json';

const testimonios = textos.testimonios as { texto: string; nombre: string; negocio: string }[];
---

{/* Sin opiniones reales en textos.json, la sección se oculta */}
{testimonios.length > 0 && (
<section class="seccion testimonios" id="opiniones">
	<div class="contenedor">
		<div class="encabezado-seccion revela">
			<h2>Lo que dicen</h2>
		</div>
		<div class="citas">
			{
				testimonios.map((t) => (
					<figure class="cita revela">
						<blockquote>“{t.texto}”</blockquote>
						<figcaption>
							<strong>{t.nombre}</strong>
							<span>{t.negocio}</span>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
)}

<style>
	.citas {
		display: grid;
		gap: 16px;
	}

	.cita {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 22px;
		border: 1px solid var(--color-borde);
		border-radius: var(--radio-lg);
		background: var(--color-superficie);
		box-shadow: var(--sombra-suave);
	}

	blockquote {
		margin: 0;
		font-size: var(--texto-lg);
		line-height: 1.6;
	}

	figcaption {
		display: flex;
		flex-direction: column;
		font-size: var(--texto-md);
	}

	figcaption span {
		color: var(--color-suave);
	}

	@media (min-width: 768px) {
		.citas {
			grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
		}
	}
</style>
