---
import textos from '../../datos/textos.json';
import { partesTitular } from '../../lib/texto';

interface Props {
	/** Sin lista, se usan las preguntas generales de textos.json. */
	lista?: { p: string; r: string }[];
	titulo?: string;
	texto?: string;
}

const { lista = textos.preguntas, titulo = 'Preguntas frecuentes', texto = 'Lo que casi todos preguntan antes de empezar.' } = Astro.props;
const preguntas = lista;
---

<section class="seccion" id="preguntas">
	<div class="contenedor preguntas">
		<div class="encabezado-seccion revela">
			<h2>{partesTitular(titulo).map((parte, i) => (i % 2 ? <em>{parte}</em> : parte))}</h2>
			<p>{texto}</p>
		</div>

		<!-- details/summary: se abre y cierra sin JavaScript y funciona con teclado -->
		<div class="lista revela">
			{
				preguntas.map((q, i) => (
					<details class="pregunta tarjeta" open={i === 0}>
						<summary>
							{q.p}
							<span class="pregunta__signo" aria-hidden="true"></span>
						</summary>
						<p>{q.r}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.preguntas {
		max-width: 760px;
	}

	.lista {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.pregunta {
		transition: border-color var(--duracion) ease;
	}

	.pregunta[open] {
		border-color: color-mix(in srgb, var(--color-marca) 50%, transparent);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 18px 20px;
		cursor: pointer;
		list-style: none;
		font-family: var(--tipo-titulos);
		font-weight: 600;
		font-size: var(--texto-base);
	}

	summary::-webkit-details-marker {
		display: none;
	}

	/* Signo + que gira a × al abrir */
	.pregunta__signo {
		position: relative;
		flex: none;
		width: 28px;
		height: 28px;
		border-radius: var(--radio-sm);
		background: var(--color-marca-suave);
		transition: rotate var(--duracion) ease;
	}

	.pregunta__signo::before,
	.pregunta__signo::after {
		content: '';
		position: absolute;
		inset: 50% auto auto 50%;
		width: 12px;
		height: 2px;
		margin: -1px 0 0 -6px;
		border-radius: var(--radio-xs);
		background: var(--color-marca-texto);
	}

	.pregunta__signo::after {
		rotate: 90deg;
	}

	.pregunta[open] .pregunta__signo {
		rotate: 45deg;
	}

	.pregunta p {
		padding: 0 20px 20px;
		color: var(--color-suave);
		font-size: var(--texto-base);
		max-width: 62ch;
	}

	@media (prefers-reduced-motion: reduce) {
		.pregunta,
		.pregunta__signo {
			transition: none;
		}
	}
</style>
