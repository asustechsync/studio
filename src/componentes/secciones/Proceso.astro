---
import textos from '../../datos/textos.json';
---

<section class="seccion proceso" id="proceso">
	<span class="proceso__brillo" aria-hidden="true"></span>
	<div class="contenedor">
		<div class="encabezado-seccion revela">
			<h2>Cómo trabajamos</h2>
			<p>Cuatro pasos, sin sorpresas.</p>
		</div>
		<ol class="pasos">
			{
				textos.pasos.map((p, i) => (
					<li class="paso tarjeta tarjeta--elevable revela">
						<span class="paso__numero">{String(i + 1).padStart(2, '0')}</span>
						<h3>{p.titulo}</h3>
						<p>{p.texto}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.proceso {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background: var(--color-fondo);
	}

	/* Brillo del acento que asoma desde abajo */
	.proceso__brillo {
		position: absolute;
		z-index: -1;
		left: 50%;
		bottom: -380px;
		width: min(90vw, 760px);
		aspect-ratio: 1;
		translate: -50% 0;
		border-radius: var(--radio-redondo);
		background: radial-gradient(circle, color-mix(in srgb, var(--color-marca) 22%, transparent) 0%, color-mix(in srgb, var(--color-marca) 7%, transparent) 30%, transparent 62%);
	}

	.pasos {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 14px;
	}

	.paso {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 22px;
	}

	.paso__numero {
		font-family: var(--tipo-titulos);
		font-weight: 600;
		font-size: var(--titulo-sm);
		line-height: 1;
		margin-bottom: 8px;
		background: linear-gradient(180deg, var(--cielo-arena), var(--cielo-terracota));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		font-variant-numeric: tabular-nums;
	}

	h3 {
		font-size: var(--texto-xl);
	}

	.paso p {
		color: var(--color-suave);
		font-size: var(--texto-md);
	}

	@media (min-width: 640px) {
		.pasos {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1024px) {
		.pasos {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
</style>
