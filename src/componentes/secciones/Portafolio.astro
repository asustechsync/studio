---
import { getCollection } from 'astro:content';
import Icono from '../ui/Icono.astro';
import { partesTitular } from '../../lib/texto';

interface Props {
	/** Slug de una solución: muestra solo sus proyectos. */
	solucion?: string;
	titulo?: string;
	texto?: string;
	/** Máximo de proyectos a mostrar. */
	limite?: number;
}

const { solucion, titulo = 'Portafolio', texto = 'Ejemplos de lo que podemos construir para tu negocio.', limite } = Astro.props;
const proyectos = (
	await getCollection('proyectos', ({ data }) => data.publicado && (!solucion || data.solucion === solucion))
)
	.sort((a, b) => a.data.orden - b.data.orden)
	.slice(0, limite);
// Rubros para los filtros, en el orden en que aparecen
const categorias = [...new Set(proyectos.map(({ data }) => data.categoria).filter(Boolean))] as string[];
// Dirección que se muestra en la barra del navegador: la del cliente, o una de ejemplo
const dominio = (enlace?: string) => {
	try {
		return enlace ? new URL(enlace).hostname.replace(/^www\./, '') : 'tuempresa.pe';
	} catch {
		return 'tuempresa.pe';
	}
};
// Fondos de reserva con los tonos del atardecer de la portada
const tonos = [
	'linear-gradient(160deg, var(--color-superficie), var(--color-marca-sombra) 55%, var(--color-marca))',
	'linear-gradient(160deg, var(--color-marca-sombra), color-mix(in srgb, var(--color-marca) 76%, black) 65%, var(--color-marca-texto))',
	'linear-gradient(160deg, var(--color-oscuro), var(--color-superficie) 55%, var(--cielo-violeta))',
	'linear-gradient(160deg, var(--cielo-violeta), color-mix(in srgb, var(--color-marca) 62%, black) 70%, var(--color-marca))',
];
---

{/* Sin proyectos publicados, el bloque entero se oculta: así no mostramos trabajos que no existen */}
{proyectos.length > 0 && (
<section class="seccion portafolio" id="portafolio">
	<div class="contenedor">
		<div class="encabezado-seccion revela">
			<h2>{partesTitular(titulo).map((parte, i) => (i % 2 ? <em>{parte}</em> : parte))}</h2>
			<p>{texto}</p>
		</div>

		{categorias.length > 1 && (
			<div class="filtros" role="group" aria-label="Filtrar proyectos por rubro">
				<button type="button" class="filtro" data-filtro="" aria-pressed="true">Todos</button>
				{categorias.map((c) => <button type="button" class="filtro" data-filtro={c} aria-pressed="false">{c}</button>)}
			</div>
		)}

		<div class="proyectos">
			{
				proyectos.map(({ data }, i) => (
					<article class="proyecto tarjeta tarjeta--elevable revela" data-categoria={data.categoria ?? ''}>
						<div class="proyecto__barra">
							<span class="proyecto__puntos" aria-hidden="true"><i></i><i></i><i></i></span>
							<span class="proyecto__url">{dominio(data.enlace)}</span>
						</div>
						<div class="proyecto__marco">
							{data.imagen ? (
								<img class="proyecto__imagen" src={data.imagen} alt={data.titulo} width="1600" height="1000" loading="lazy" decoding="async" />
							) : (
								<div class="proyecto__imagen" style={`background:${tonos[i % tonos.length]}`} />
							)}
							{/* Sin enlace del cliente, es un diseño de ejemplo y se dice claro */}
							{(!data.enlace || data.categoria) && (
								<span class="proyecto__categoria">{[data.enlace ? null : 'Ejemplo', data.categoria].filter(Boolean).join(' · ')}</span>
							)}
						</div>
						<div class="proyecto__texto">
							<span class="proyecto__antetitulo">{data.enlace ? 'Proyecto destacado' : 'Diseño de ejemplo'}{data.categoria && ` · ${data.categoria}`}</span>
							<h3>{data.titulo}</h3>
							<p>{data.descripcion}</p>
							{data.ventajas.length > 0 && (
								<ul class="proyecto__ventajas">
									{data.ventajas.map((v) => <li>{v}</li>)}
								</ul>
							)}
							{/* Sin enlace del cliente todavía, el botón lleva a los planes de su solución */}
							<a
								class="proyecto__boton"
								href={data.enlace || (solucion ? '#planes' : data.solucion ? `/soluciones/${data.solucion}#planes` : '/soluciones')}
								target={data.enlace ? '_blank' : undefined}
								rel={data.enlace ? 'noopener noreferrer' : undefined}
							>
								{data.enlace ? 'Ver proyecto' : 'Ver planes'}
								<Icono nombre="flecha" tamano={16} />
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
)}

<script>
	// Filtra por rubro y deja el primer proyecto visible como el destacado
	document.querySelectorAll<HTMLElement>('.portafolio').forEach((seccion) => {
		const botones = seccion.querySelectorAll<HTMLButtonElement>('.filtro');
		const tarjetas = seccion.querySelectorAll<HTMLElement>('.proyecto');

		const aplicar = (filtro: string) => {
			let primero = true;
			tarjetas.forEach((t) => {
				const visible = !filtro || t.dataset.categoria === filtro;
				t.hidden = !visible;
				t.classList.toggle('proyecto--destacado', visible && primero);
				if (visible) primero = false;
			});
			botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === filtro)));
		};

		botones.forEach((b) => b.addEventListener('click', () => aplicar(b.dataset.filtro ?? '')));
		aplicar('');
	});
</script>

<style>
	.portafolio {
		background: var(--color-fondo);
	}

	.proyectos {
		display: grid;
		gap: 18px;
	}

	.proyecto {
		overflow: hidden;
	}

	/* Barra de navegador sobre la captura */
	.proyecto__barra {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 12px 16px;
		border-bottom: 1px solid var(--color-borde);
	}

	.proyecto__puntos {
		display: flex;
		gap: 6px;
	}

	.proyecto__puntos i {
		width: 10px;
		height: 10px;
		border-radius: var(--radio-redondo);
		background: var(--color-borde);
	}

	.proyecto__url {
		flex: 1;
		padding: 5px 14px;
		border-radius: var(--radio-sm);
		background: var(--color-fondo);
		font-family: var(--tipo-mono);
		font-size: var(--texto-xs);
		text-align: center;
		color: var(--color-suave);
	}

	.proyecto__marco {
		position: relative;
		overflow: hidden;
	}

	.proyecto__categoria {
		position: absolute;
		left: 14px;
		bottom: 14px;
		padding: 4px 10px;
		border-radius: var(--radio-xs);
		border: 1px solid var(--color-borde);
		background: color-mix(in srgb, var(--color-oscuro) 78%, transparent);
		backdrop-filter: blur(6px);
		font-size: var(--texto-xs);
		font-weight: 600;
		color: var(--color-texto);
	}

	.proyecto__imagen {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		transition: scale 0.5s var(--curva-suave);
	}

	.proyecto:hover .proyecto__imagen {
		scale: 1.04;
	}

	@media (prefers-reduced-motion: reduce) {
		.proyecto,
		.proyecto__imagen {
			transition: none;
		}
	}

	.proyecto__texto {
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	h3 {
		font-size: var(--texto-xl);
	}

	.proyecto__texto p {
		color: var(--color-suave);
		font-size: var(--texto-md);
	}

	.proyecto[hidden] {
		display: none;
	}

	/* Filtros por rubro */
	.filtros {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		margin: 0 0 28px;
	}

	.filtro {
		padding: 7px 16px;
		border-radius: var(--radio-sm);
		border: 1px solid var(--color-borde);
		background: var(--color-superficie);
		font: inherit;
		font-size: var(--texto-sm);
		font-weight: 600;
		color: var(--color-suave);
		cursor: pointer;
		transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
	}

	.filtro:hover {
		color: var(--color-texto);
		border-color: var(--color-suave);
	}

	.filtro[aria-pressed='true'] {
		color: var(--color-sobre-marca);
		background: var(--color-marca);
		border-color: var(--color-marca);
	}

	/* Ventajas como lista con checks, bajo una línea fina */
	.proyecto__ventajas {
		list-style: none;
		margin: 0;
		padding: 14px 0 0;
		display: grid;
		gap: 8px;
		border-top: 1px solid var(--color-borde);
		font-size: var(--texto-md);
		color: var(--color-texto);
	}

	.proyecto__ventajas li::before {
		content: '✓';
		margin-right: 10px;
		color: var(--color-marca);
	}

	/* Botón del destacado */
	.proyecto__boton {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 6px;
		padding: 9px 16px;
		border: 1px solid var(--color-borde);
		border-radius: var(--radio-sm);
		font-size: var(--texto-md);
		font-weight: 600;
		text-decoration: none;
		color: var(--color-texto);
		transition: border-color 0.2s ease, color 0.2s ease;
	}

	.proyecto__boton:hover {
		color: var(--color-sobre-marca);
		background: var(--color-marca);
		border-color: var(--color-marca);
	}

	.proyecto__antetitulo {
		display: none;
		font-size: var(--texto-2xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-suave);
	}

	.proyecto--destacado .proyecto__antetitulo {
		display: block;
	}

	.proyecto:not(.proyecto--destacado) .proyecto__barra,
	.proyecto:not(.proyecto--destacado) .proyecto__ventajas,
	.proyecto:not(.proyecto--destacado) .proyecto__boton {
		display: none;
	}

	.proyecto:not(.proyecto--destacado) .proyecto__texto {
		padding: 16px 18px 18px;
		gap: 4px;
	}

	.proyecto:not(.proyecto--destacado) .proyecto__texto p {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: var(--texto-sm);
	}

	.proyecto:not(.proyecto--destacado) h3 {
		font-size: var(--texto-lg);
	}

	@media (min-width: 640px) {
		.proyectos {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 24px;
		}

		/* El destacado ocupa toda la fila: captura a la izquierda, texto a la derecha */
		.proyecto--destacado {
			grid-column: 1 / -1;
			display: grid;
			grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
			grid-template-rows: auto 1fr;
		}

		.proyecto--destacado .proyecto__barra,
		.proyecto--destacado .proyecto__marco {
			grid-column: 1;
		}

		.proyecto--destacado .proyecto__texto {
			grid-column: 2;
			grid-row: 1 / span 2;
			justify-content: center;
			align-items: flex-start;
			gap: 14px;
			padding: 36px;
			border-left: 1px solid var(--color-borde);
		}

		.proyecto--destacado .proyecto__ventajas {
			align-self: stretch;
		}

		.proyecto--destacado h3 {
			font-size: var(--texto-3xl);
		}

		.proyecto--destacado .proyecto__texto p {
			font-size: var(--texto-base);
		}
	}
</style>
