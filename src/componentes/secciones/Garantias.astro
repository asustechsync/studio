---
import textos from '../../datos/textos.json';
import Icono from '../ui/Icono.astro';

interface Props {
	titulo?: string;
	texto?: string;
}

const {
	titulo = 'Trabajo con garantías claras',
	texto = 'Sabes qué recibes, cuándo lo recibes y qué pasa después de publicar.',
} = Astro.props;
const { garantias } = textos;
---

<section class="seccion garantias" aria-label="Garantías">
	<div class="contenedor">
		<div class="encabezado-seccion revela">
			<h2>{titulo}</h2>
			<p>{texto}</p>
		</div>

		<ul class="garantias__lista">
			{
				garantias.map((g) => (
					<li class="garantia tarjeta tarjeta--elevable revela">
						<span class="garantia__icono">
							<Icono nombre={g.icono as 'rayo' | 'escudo' | 'calendario'} tamano={20} />
						</span>
						<div>
							<h3>{g.titulo}</h3>
							<p>{g.texto}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.garantias {
		background: var(--color-fondo);
	}

	.garantias__lista {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 14px;
	}

	.garantia {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 18px 20px;
	}

	/* Ícono en un cuadro índigo suave, como los de la referencia */
	.garantia__icono {
		flex: none;
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		border-radius: var(--radio);
		color: var(--color-marca-texto);
		background: var(--color-marca-suave);
		border: 1px solid color-mix(in srgb, var(--color-marca) 15%, transparent);
	}

	h3 {
		font-size: var(--texto-lg);
	}

	.garantia p {
		color: var(--color-suave);
		font-size: var(--texto-md);
		margin-top: 2px;
	}

	@media (min-width: 768px) {
		.garantias__lista {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
