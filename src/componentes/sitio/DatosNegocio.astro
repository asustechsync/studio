---
// Datos estructurados (Schema.org) para que Google entienda quién es el negocio
// y qué paquetes ofrece. Salen de negocio.json y de la colección de paquetes.
import { getCollection } from 'astro:content';
import negocio from '../../datos/negocio.json';

const [ciudad, pais] = negocio.ciudad.split(',').map((parte) => parte.trim());
const paquetes = (await getCollection('paquetes', ({ data }) => data.publicado)).sort(
	(a, b) => a.data.orden - b.data.orden,
);

const datos = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: negocio.marca,
	description: negocio.descripcion,
	url: Astro.site?.href,
	telephone: `+${negocio.whatsapp}`,
	email: negocio.correo,
	taxID: negocio.ruc,
	address: { '@type': 'PostalAddress', addressLocality: ciudad, addressCountry: pais === 'Perú' ? 'PE' : pais },
	areaServed: ciudad,
	...(negocio.imagenCompartir && { image: new URL(negocio.imagenCompartir, Astro.site).href }),
	makesOffer: paquetes.map(({ data }) => ({
		'@type': 'Offer',
		name: data.nombre,
		price: data.precio,
		priceCurrency: 'PEN',
		description: data.incluye.join('. '),
	})),
};
---

<script type="application/ld+json" set:html={JSON.stringify(datos).replace(/</g, '\\u003c')} />
