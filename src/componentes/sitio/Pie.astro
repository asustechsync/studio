---
import negocio from '../../datos/negocio.json';
import textos from '../../datos/textos.json';
import { enlaceWhatsapp } from '../../lib/enlaces';
import { getCollection } from 'astro:content';
import Icono from '../ui/Icono.astro';

const { pie } = negocio;
const hayProyectos = (await getCollection('proyectos', ({ data }) => data.publicado)).length > 0;

const navegacion = [
	{ texto: 'Soluciones', href: '/soluciones' },
	...(hayProyectos ? [{ texto: 'Portafolio', href: '/portafolio' }] : []),
	{ texto: 'Contacto', href: '/contacto' },
];
const redes = [
	{ texto: 'Instagram', href: pie.instagram },
	{ texto: 'Facebook', href: pie.facebook },
	{ texto: 'TikTok', href: pie.tiktok },
].filter((r) => r.href);
const telefono = `+${negocio.whatsapp.slice(0, 2)} ${negocio.whatsapp.slice(2)}`;
const anio = new Date().getFullYear();
---

<footer class="pie">
	<div class="contenedor">
		<div class="pie__llamado revela">
			<h2>{textos.llamado.titulo}</h2>
			<p>{textos.llamado.texto}</p>
			<a class="boton boton--marca pie__boton" href={enlaceWhatsapp()} target="_blank" rel="noopener noreferrer">
			<Icono nombre="whatsapp" />
				{textos.llamado.boton}
			</a>
		</div>
	</div>

	<div class="contenedor pie__rejilla">
		<div class="pie__marca">
			<a class="pie__logo" href="/">{negocio.marca}</a>
			<p>{textos.portada.antetitulo}. {negocio.ciudad}.</p>
		</div>

		<nav class="pie__columna" aria-label="Pie">
			<h2>Navegación</h2>
			{navegacion.map((e) => <a href={e.href}>{e.texto}</a>)}
		</nav>

		<div class="pie__columna">
			<h2>Contacto</h2>
			<a href={enlaceWhatsapp()} target="_blank" rel="noopener noreferrer">
				<Icono nombre="whatsapp" />
				{telefono}
			</a>
			<a href={`mailto:${negocio.correo}`}>{negocio.correo}</a>
			{pie.horario && <span>{pie.horario}</span>}
		</div>

		{
			redes.length > 0 && (
				<div class="pie__columna">
					<h2>Redes</h2>
					{redes.map((r) => (
						<a href={r.href} target="_blank" rel="noopener noreferrer">{r.texto}</a>
					))}
				</div>
			)
		}
	</div>

	<div class="contenedor pie__base">
		<span>© {anio} {negocio.marca}. Todos los derechos reservados.</span>
		<span>RUC {negocio.ruc} · {negocio.ciudad}</span>
	</div>
</footer>

<style>
	.pie {
		background: var(--color-fondo);
		color: var(--color-suave);
		font-size: var(--texto-md);
		padding-top: 8px;
	}

	/* Recuadro final oscuro con brillo del acento abajo */
	.pie__llamado {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 12px;
		padding: 56px 24px;
		border-radius: var(--radio-lg);
		border: 1px solid var(--color-borde);
		background:
			radial-gradient(ellipse 70% 90% at 50% 130%, color-mix(in srgb, var(--color-marca) 45%, transparent), transparent 70%),
			var(--color-superficie);
	}

	.pie__llamado h2 {
		font-size: var(--titulo-seccion);
		letter-spacing: -0.03em;
		color: var(--color-texto);
		max-width: 20ch;
	}

	.pie__llamado p {
		font-size: var(--texto-lg);
		color: var(--color-suave);
		max-width: 44ch;
		margin-bottom: 8px;
	}

	.pie__boton {
		min-height: 46px;
		padding-inline: 20px;
	}

	.pie__rejilla {
		display: grid;
		gap: 32px;
		padding-block: 48px 36px;
	}

	.pie__logo {
		font-size: var(--texto-2xl);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--color-texto);
		text-decoration: none;
	}

	.pie__marca p {
		margin-top: 10px;
		max-width: 32ch;
		line-height: 1.5;
	}

	.pie__columna {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
	}

	.pie__columna h2 {
		font-size: var(--texto-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-suave);
		margin-bottom: 2px;
	}

	.pie__columna a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.pie__columna a:hover {
		color: var(--color-texto);
	}

	.pie__base {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 24px;
		padding-block: 20px 28px;
		border-top: 1px solid var(--color-borde);
		font-size: var(--texto-sm);
	}

	@media (min-width: 768px) {
		.pie__llamado {
			padding-block: 72px;
		}

		.pie__rejilla {
			grid-template-columns: 1.6fr 1fr 1.2fr 1fr;
			gap: 40px;
		}
	}
</style>
