---
import sitio from '../datos/sitio.json';
import { enlaceWhatsapp } from '../lib/enlaces';
import Icono from './Icono.astro';
import PanelMuestra from './PanelMuestra.astro';

const { portada } = sitio;

// Cerros del desierto de Tacna en tonos arena, de lejos a cerca. Cada capa se mueve distinto al hacer scroll.
const capas = [
	{ clase: 'lejos', color: '#2b221d', d: 'M0 250 C160 190 300 225 420 185 C560 135 660 205 800 165 C940 125 1060 195 1200 155 C1300 125 1380 165 1440 145 V400 H0Z' },
	{ clase: 'medio', color: '#241d19', d: 'M0 295 C120 245 260 285 380 238 C500 190 600 268 740 228 C880 188 980 258 1120 218 C1260 178 1360 248 1440 218 V400 H0Z' },
	{ clase: 'cerca', color: '#1c1815', d: 'M0 338 C180 288 300 328 460 298 C620 268 720 328 900 298 C1060 273 1200 328 1440 288 V400 H0Z' },
	{ clase: 'suelo', color: '#161311', d: 'M0 378 C240 348 480 373 720 358 C960 343 1200 370 1440 353 V400 H0Z' },
];
---

<section class="portada">
	<div class="portada__fondo" aria-hidden="true">
		<span class="portada__sol"></span>
		{
			capas.map((capa) => (
				<svg class:list={['capa', `capa--${capa.clase}`]} viewBox="0 0 1440 400" preserveAspectRatio="xMidYMax slice">
					<path d={capa.d} fill={capa.color} />
				</svg>
			))
		}
	</div>

	<div class="contenedor portada__texto">
		<span class="portada__antetitulo entra" style="--i:0">{portada.antetitulo}</span>
		<h1 class="entra" style="--i:1">
			{portada.titulo.inicio} <em>{portada.titulo.cursiva}</em> {portada.titulo.fin}
		</h1>
		<p class="portada__subtitulo entra" style="--i:2">{portada.subtitulo}</p>
		<div class="portada__acciones entra" style="--i:3">
			<a class="portada__boton portada__boton--claro" href="#soluciones">
				Ver soluciones
				<Icono nombre="flecha" />
			</a>
			{
				portada.enlaceDemo ? (
					<a class="portada__boton" href={portada.enlaceDemo} target="_blank" rel="noopener">
						<Icono nombre="reproducir" />
						Probar tienda demo
					</a>
				) : (
					<a class="portada__boton" href={enlaceWhatsapp()} target="_blank" rel="noopener">
						<Icono nombre="whatsapp" />
						Escríbenos
					</a>
				)
			}
		</div>
	</div>

	<div class="contenedor portada__escena">
		<div class="portada__inclinacion">
			<div class="portada__panel">
				<PanelMuestra />
			</div>
		</div>
	</div>
</section>

<style>
	.portada {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		margin-top: calc(var(--alto-cabecera) * -1);
		padding-top: 128px;
		background: var(--color-fondo);
		color: var(--color-texto);
		text-align: center;
	}

	/* Cielo de atardecer, sol y cerros */
	.portada__fondo {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(180deg, #141413 0%, #141413 45%, #1a1511 80%, #211a14 100%);
		transform-origin: 50% 80%;
	}

	.portada__sol {
		position: absolute;
		left: 50%;
		top: 66%;
		width: min(70vw, 720px);
		aspect-ratio: 1;
		translate: -50% -50%;
		border-radius: 50%;
		background: radial-gradient(circle, rgb(217 119 87 / 0.22) 0%, rgb(217 119 87 / 0.08) 32%, transparent 62%);
	}

	.capa {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 62%;
	}

	.portada__texto {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 18px;
	}

	.portada__antetitulo {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.04em;
		padding: 5px 14px;
		border-radius: 999px;
		color: var(--color-marca-texto);
		background: rgb(255 255 255 / 0.05);
		border: 1px solid var(--color-borde);
	}

	h1 {
		color: var(--color-texto);
		font-size: 38px;
		line-height: 1.08;
		letter-spacing: -0.02em;
		max-width: 20ch;
		text-wrap: balance;
	}

	/* Palabras destacadas en cursiva serif, como en la referencia */
	h1 em {
		font-family: var(--tipo-cursiva);
		font-style: italic;
		font-weight: 400;
		font-size: 1.14em;
		letter-spacing: 0;
		color: var(--color-marca);
	}

	.portada__subtitulo {
		color: var(--color-suave);
		font-size: 17px;
		max-width: 46ch;
	}

	.portada__acciones {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
		margin-top: 6px;
	}

	.portada__boton {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 46px;
		padding: 10px 22px;
		border-radius: 999px;
		font-weight: 600;
		font-size: 15px;
		text-decoration: none;
		color: var(--color-texto);
		background: rgb(255 255 255 / 0.06);
		border: 1px solid #3d3a34;
		transition: background-color 0.2s ease, transform 0.15s ease;
	}

	.portada__boton:hover {
		background: rgb(255 255 255 / 0.12);
	}

	.portada__boton--claro {
		background: var(--color-marca);
		color: #141413;
		border-color: transparent;
	}

	.portada__boton--claro:hover {
		background: #e5895f;
	}

	.portada__boton:active {
		transform: scale(0.98);
	}

	/* El panel asoma desde abajo y queda cortado por el borde de la portada */
	.portada__escena {
		position: relative;
		margin-top: 48px;
		max-width: 980px;
		height: 330px;
		perspective: 1600px;
	}

	.portada__inclinacion {
		transform-origin: 50% 0;
	}

	@media (min-width: 640px) {
		.portada__escena {
			height: 400px;
		}
	}

	@media (min-width: 900px) {
		.portada {
			padding-top: 150px;
		}

		h1 {
			font-size: 54px;
		}

		.portada__subtitulo {
			font-size: 19px;
		}

		.portada__escena {
			margin-top: 64px;
			height: 440px;
		}
	}

	/* Movimiento: solo si la persona no pidió reducirlo */
	@media (prefers-reduced-motion: no-preference) {
		.entra {
			animation: portada-entra 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
			animation-delay: calc(var(--i) * 90ms + 120ms);
		}

		.portada__fondo {
			animation: portada-acerca 2.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		}

		.portada__panel {
			animation: portada-sube 1.2s 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		}

		.portada__inclinacion {
			transform: rotateX(16deg) scale(0.94);
		}

		@supports (animation-timeline: view()) {
			.portada__inclinacion {
				animation: portada-endereza linear both;
				animation-timeline: view();
				animation-range: entry 10% cover 50%;
			}

			.capa--lejos,
			.capa--medio,
			.capa--cerca {
				animation: portada-paralaje linear both;
				animation-timeline: scroll(root);
				animation-range: 0px 700px;
			}

			.capa--lejos {
				--desplazamiento: 140px;
			}

			.capa--medio {
				--desplazamiento: 80px;
			}

			.capa--cerca {
				--desplazamiento: 30px;
			}
		}
	}

	@keyframes portada-entra {
		from {
			opacity: 0;
			transform: translateY(18px);
			filter: blur(8px);
		}
	}

	@keyframes portada-acerca {
		from {
			transform: scale(1.08);
		}
	}

	@keyframes portada-sube {
		from {
			opacity: 0;
			transform: translateY(120px);
		}
	}

	@keyframes portada-endereza {
		from {
			transform: rotateX(16deg) scale(0.94);
		}
		to {
			transform: rotateX(0deg) scale(1);
		}
	}

	@keyframes portada-paralaje {
		to {
			transform: translateY(var(--desplazamiento));
		}
	}
</style>
