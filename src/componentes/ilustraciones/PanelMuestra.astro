---
// Maqueta del Panel Studio que se muestra en la portada. Los números son de ejemplo.
const barras = [32, 45, 38, 52, 48, 61, 55, 70, 64, 78, 72, 88];
const pedidos = [
	{ codigo: '#1042', detalle: 'Polo básico x2', monto: 'S/ 78', estado: 'Yape' },
	{ codigo: '#1041', detalle: 'Medias x3', monto: 'S/ 25', estado: 'Plin' },
	{ codigo: '#1040', detalle: 'Casaca denim', monto: 'S/ 149', estado: 'Tarjeta' },
];
---

<div class="panel" data-animado role="img" aria-label="Ejemplo del panel de administración con ventas, pedidos y visitas">
	<div class="panel__barra">
		<span class="panel__puntos"><i></i><i></i><i></i></span>
		<span class="panel__url">panel.tunegocio.pe</span>
		<span class="panel__usuario">Rosa M.</span>
	</div>
	<div class="panel__cuerpo">
		<div class="panel__pestanas">
			<b>Resumen</b><span>Pedidos</span><span>Productos</span><span>Contenido</span>
		</div>
		<div class="panel__datos">
			<div class="dato">
				<span class="dato__titulo">Ventas del mes</span>
				<b class="dato__cifra">S/ 8,420</b>
				<span class="dato__nota">+18 % frente a octubre</span>
				<div class="dato__barras">{barras.map((h) => <i style={`height:${h}%`}></i>)}</div>
			</div>
			<div class="dato">
				<span class="dato__titulo">Pedidos por WhatsApp</span>
				<b class="dato__cifra">64</b>
				<span class="dato__nota">12 esta semana</span>
				<div class="dato__puntos">{Array.from({ length: 28 }, (_, i) => <i class:list={{ activo: i % 3 !== 1 }}></i>)}</div>
			</div>
			<div class="dato dato--extra">
				<span class="dato__titulo">Visitas a la web</span>
				<b class="dato__cifra">1,920</b>
				<span class="dato__nota">68 % desde celular</span>
				<div class="dato__columnas"><i style="height:40%"></i><i style="height:62%"></i><i style="height:48%"></i><i class="alta" style="height:92%"></i><i style="height:55%"></i></div>
			</div>
		</div>
		<div class="panel__lista">
			<span class="dato__titulo">Últimos pedidos</span>
			{
				pedidos.map((p) => (
					<div class="fila">
						<span class="fila__codigo">{p.codigo}</span>
						<span class="fila__detalle">{p.detalle}</span>
						<span class="fila__estado">{p.estado}</span>
						<b>{p.monto}</b>
					</div>
				))
			}
		</div>
	</div>
</div>

<style>
	.panel {
		--vidrio: color-mix(in srgb, var(--color-fondo) 72%, transparent);
		--linea: color-mix(in srgb, var(--color-blanco) 10%, transparent);
		--suave: color-mix(in srgb, var(--color-blanco) 60%, transparent);
		color: var(--color-blanco);
		background: var(--vidrio);
		border: 1px solid var(--linea);
		border-radius: 14px;
		backdrop-filter: blur(14px) saturate(1.2);
		box-shadow: 0 30px 80px color-mix(in srgb, var(--color-negro) 45%, transparent);
		overflow: hidden;
		text-align: left;
	}

	.panel__barra {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 9px 14px;
		border-bottom: 1px solid var(--linea);
		font-size: 11px;
		color: var(--suave);
	}

	.panel__puntos {
		display: flex;
		gap: 5px;
	}

	.panel__puntos i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-blanco) 22%, transparent);
	}

	.panel__url {
		flex: 1;
		text-align: center;
		background: color-mix(in srgb, var(--color-blanco) 6%, transparent);
		border-radius: 6px;
		padding: 3px 10px;
		max-width: 260px;
		margin-inline: auto;
	}

	.panel__cuerpo {
		padding: 16px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.panel__pestanas {
		display: flex;
		gap: 14px;
		font-family: var(--tipo-titulos);
		font-size: 22px;
		color: color-mix(in srgb, var(--color-blanco) 35%, transparent);
	}

	.panel__pestanas b {
		color: var(--color-blanco);
		font-weight: 600;
	}

	.panel__pestanas span:nth-child(n + 3) {
		display: none;
	}

	.panel__datos {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 10px;
	}

	.dato,
	.panel__lista {
		background: color-mix(in srgb, var(--color-blanco) 5%, transparent);
		border: 1px solid var(--linea);
		border-radius: 10px;
		padding: 12px;
		display: flex;
		flex-direction: column;
		gap: 3px;
		min-width: 0;
	}

	.dato--extra {
		display: none;
	}

	.dato__titulo {
		font-size: 11px;
		color: var(--suave);
	}

	.dato__cifra {
		font-family: var(--tipo-titulos);
		font-size: 22px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.dato__nota {
		font-size: 10.5px;
		color: var(--color-exito);
	}

	.dato__barras,
	.dato__columnas {
		display: flex;
		align-items: flex-end;
		gap: 3px;
		height: 54px;
		margin-top: 8px;
	}

	.dato__barras i {
		flex: 1;
		background: color-mix(in srgb, var(--color-blanco) 55%, transparent);
		border-radius: 2px;
	}

	.dato__columnas i {
		flex: 1;
		background: color-mix(in srgb, var(--color-blanco) 18%, transparent);
		border-radius: 3px;
	}

	.dato__columnas i.alta {
		background: var(--color-blanco);
	}

	.dato__puntos {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 7px;
		margin-top: 10px;
		justify-items: center;
	}

	.dato__puntos i {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-blanco) 18%, transparent);
	}

	.dato__puntos i.activo {
		background: var(--color-blanco);
	}

	.fila {
		display: grid;
		grid-template-columns: 48px minmax(0, 1fr) auto;
		gap: 10px;
		align-items: center;
		font-size: 12px;
		padding-top: 7px;
		border-top: 1px solid var(--linea);
		margin-top: 5px;
	}

	.fila__codigo,
	.fila__estado {
		color: var(--suave);
	}

	.fila__detalle {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.fila__estado {
		display: none;
	}

	@media (min-width: 640px) {
		.panel__cuerpo {
			padding: 22px;
			gap: 14px;
		}

		.panel__pestanas {
			font-size: 28px;
			gap: 18px;
		}

		.panel__pestanas span:nth-child(n + 3) {
			display: inline;
		}

		.panel__datos {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.dato--extra {
			display: flex;
		}

		.fila {
			grid-template-columns: 56px minmax(0, 1fr) 80px 64px;
		}

		.fila__estado {
			display: block;
		}

		.fila b {
			text-align: right;
		}
	}
</style>
