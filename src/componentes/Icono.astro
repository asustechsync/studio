---
// Iconos de trazo (24x24) que heredan el color del texto.
const trazos = {
	whatsapp: [
		'M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21',
		'M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1',
	],
	flecha: ['M5 12h14', 'M13 18l6-6', 'M13 6l6 6'],
	reproducir: ['M7 4v16l13-8z'],
	rayo: ['M13 3v7h6l-8 11v-7H5l8-11'],
	escudo: ['M12 3a12 12 0 0 0 8.5 3A12 12 0 0 1 12 21 12 12 0 0 1 3.5 6 12 12 0 0 0 12 3', 'M9 12l2 2 4-4'],
	calendario: ['M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z', 'M16 3v4', 'M8 3v4', 'M4 11h16'],
	check: ['M5 12l5 5L20 7'],
	menos: ['M5 12h14'],
	mundo: [
		'M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0',
		'M3.6 9h16.8',
		'M3.6 15h16.8',
		'M11.5 3a17 17 0 0 0 0 18',
		'M12.5 3a17 17 0 0 1 0 18',
	],
	carrito: ['M6 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0', 'M15 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0', 'M17 17h-11v-14h-2', 'M6 5l14 1l-1 7h-13'],
	enlace: ['M12 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6', 'M11 13l9-9', 'M15 4h5v5'],
	celular: ['M6 5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z', 'M11 4h2', 'M12 17v.01'],
	buscar: ['M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0', 'M21 21l-6-6'],
	barras: ['M4 20h16', 'M7 16v-5', 'M12 16V7', 'M17 16v-8'],
} as const;

interface Props {
	nombre: keyof typeof trazos;
	tamano?: number;
}

const { nombre, tamano = 18 } = Astro.props;
---

<svg
	width={tamano}
	height={tamano}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{trazos[nombre].map((d) => <path d={d} />)}
</svg>
